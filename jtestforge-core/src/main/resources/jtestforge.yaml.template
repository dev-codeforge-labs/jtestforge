# =============================================================================
# JTestForge configuration
# =============================================================================

project:
  # Maven module JTestForge operates on. Must build green before a run.
  modulePath: .
  mavenExecutable: mvn
  # Extra args prepended to every Maven invocation. -o keeps the loop offline.
  mavenArgs: ["-o", "-B"]
  # JDK every Maven call runs on, exported as JAVA_HOME. Empty: whatever mvn picks up
  # normally. Overridden per invocation by --java-home.
  javaHome:
  # Java release the module's code is written for (8, 1.8, 11, 17...). Empty: detected
  # from the pom's compiler settings (parents included), else from target/ bytecode.
  # Overridden per invocation by --java-version.
  javaVersion:
  # Character encoding of the module's Java sources (UTF-8, ISO-8859-1, windows-1252...).
  # Every test and production file is read and written back in it, so a legacy module saved
  # as ISO-8859-1 keeps its accents byte for byte. Empty: detected from the pom chain
  # (maven-compiler-plugin <encoding>, maven.compiler.encoding, project.build.sourceEncoding),
  # else UTF-8 with a warning. Overridden per invocation by --source-encoding.
  sourceEncoding:
  # Saved `mvn dependency:tree` output used INSTEAD of running Maven to resolve the
  # module's dependencies. One file may cover the whole multi-module application; the
  # module's block is found by its groupId:artifactId. Create it from the reactor root:
  #   mvn test-compile dependency:tree -DoutputFile=C:/tmp/deps-tree.txt -DappendOutput=true
  # Empty: dependencies are resolved by running Maven, as usual. Overridden per
  # invocation by --dependency-tree.
  dependencyTreeFile:
  # Local Maven repository holding the jars named in dependencyTreeFile (also used, with
  # a dependencyTreeFile, to resolve a parent pom.xml when detecting javaVersion). Empty:
  # detected the way Maven itself would (-Dmaven.repo.local in mavenArgs, then
  # ~/.m2/settings.xml, then the Maven installation's own settings.xml, then
  # ~/.m2/repository). Overridden per invocation by --local-repository.
  localRepository:
  testSourceRoot: src/test/java
  mainSourceRoot: src/main/java
  # Test class naming for a production class Foo -> FooTest.
  # One class per tier (7.2); an existing slice class is detected by its annotations
  # rather than by its name, so these suffixes only govern files JTestForge creates.
  testClassSuffix: Test
  testClassSuffixByTier:
    WEB_SLICE:     WebTest
    DATA_SLICE:    DataTest
    JSON_SLICE:    JsonTest
    CONTEXT_SLICE: ContextTest

# --- What to work on ---------------------------------------------------------
selection:
  includePackages: []
  excludePackages: []
  # Never touched: JPA entities, DTOs, generated sources, anything matching these.
  excludeClasses:
    - "**/*Config"
    - "**/*Application"
    - "**/dto/**"
  # Skip classes annotated with any of these (entities are behaviour-free).
  excludeAnnotations: ["jakarta.persistence.Entity", "lombok.Generated"]
  # A method below this cyclomatic complexity is not worth a generated test.
  minComplexity: 2
  includePrivateMethods: false
  # Ordering of work units. lowestCoverageFirst puts the biggest wins first.
  order: lowestCoverageFirst   # lowestCoverageFirst | alphabetical | declaration

# --- AI provider -------------------------------------------------------------
aiProvider:
  active: claude
  # Start the AI CLI in an EMPTY directory instead of the target module.
  #
  # Modern AI CLIs are agentic: they treat their working directory as a workspace and
  # grep/read files in it before answering. Pointed at a large legacy module (whose
  # target/ this tool keeps repopulating), that turns a one-shot question into minutes
  # of tool round-trips per call. JTestForge already puts the full production class,
  # collaborator signatures and the existing test class INTO the prompt, so the CLI has
  # nothing to gain from the module being in view. The empty directory is created at
  # <stateDir>/ai-cwd. Set false only for a provider that genuinely needs the module.
  isolateWorkingDirectory: true
  providers:
    claude:
      command: claude
      # Argument LIST, never a single string: quoting on Windows is a bug farm.
      args: ["-p", "--output-format", "text"]
      promptDelivery: stdin        # stdin | argument | file
      timeoutSeconds: 300
      # Retries for transport failures only (non-zero exit, timeout, empty output).
      transportRetries: 2
      # Overrides context.maxPromptChars for this provider only. Empty: use the global
      # value below. Set this per provider when its context window differs from the
      # others - a locally hosted model routinely has a far smaller one than a hosted CLI.
      # maxPromptChars:
    gemini:
      command: gemini.cmd
      # An empty -p value switches gemini to non-interactive mode without putting the
      # prompt itself on the command line - gemini's own --help documents -p's value as
      # "Appended to input on stdin (if any)", so the real prompt travels via stdin below.
      # promptDelivery: argument would put the whole prompt on the command line instead,
      # which is what used to fail on Windows: cmd.exe's ~8191-char line limit for
      # anything beyond a trivial method, and mangled quoting/backslashes for the rest.
      args: ["-p", ""]
      promptDelivery: stdin        # stdin | argument | file
      # Worst case per unit is timeoutSeconds x (transportRetries + 1). The timeout is
      # enforced by killing the whole process tree, not just the launched command - a
      # .cmd wrapper that shells out to node.exe would otherwise leave that child alive
      # holding the output pipe, stalling the run long past this value.
      timeoutSeconds: 300
      transportRetries: 2
      # Environment variables for THIS CLI only, merged over the inherited environment.
      # JTestForge does not interpret them. Useful when the CLI's own defaults do not fit
      # a locked-down corporate machine:
      # env:
      #   GEMINI_CLI_HOME: C:/tools/gemini-home   # see the policies note below
      #   DEBUG: "1"                              # the CLI logs what it is doing; its
      #                                           # stderr is kept per attempt in
      #                                           # <stateDir>/transcripts/<unit>/N.stderr.log
    # GitHub Copilot CLI. Verified against the fixture module (jtestforge-implementation-
    # plan.md, tuning loop): the response contract, the imports-block normalisation and
    # the BARE_STATUS quality guard all held with no ResponseParser changes needed.
    copilot:
      command: copilot
      # --allow-all-tools is required by the CLI itself for non-interactive mode (-p),
      # even though isolateWorkingDirectory (and --available-tools with no values, which
      # disables every tool outright - see the PERFORMANCE note below) leave it nothing
      # to approve. -s (silent) keeps stdout to just the agent's answer, which is what
      # the response contract (§6.2) needs; anything it logs instead goes to stderr.
      args: ["--allow-all-tools", "--available-tools", "-s", "--log-level", "error"]
      promptDelivery: stdin        # stdin | argument | file
      timeoutSeconds: 300
      transportRetries: 2
    # OpenAI Codex CLI. Verified against the fixture module the same way as the providers
    # above; the first pass found a real ResponseParser gap (a bare static-member import
    # missing the `static` keyword, e.g. org.junit.jupiter.api.Assertions.assertTrue) that
    # is now fixed and covered by a regression test - see ResponseParser's javadoc.
    codex:
      command: codex
      # exec is Codex's non-interactive subcommand; without --skip-git-repo-check it
      # refuses to run outside a git repository, which the isolated ai-cwd deliberately
      # is not. --sandbox read-only denies file writes and network/shell access for the
      # model's own tool calls - belt and suspenders alongside isolateWorkingDirectory,
      # since rules.md already tells the model not to use any tool. --color never keeps
      # stdout free of ANSI escapes. The banner, prompt echo and token-usage stats Codex
      # prints go to STDERR, not stdout - stdout is exactly the model's final answer, the
      # same clean shape as claude/gemini/copilot.
      args: ["exec", "--skip-git-repo-check", "--sandbox", "read-only", "--color", "never"]
      promptDelivery: stdin        # stdin | argument | file
      timeoutSeconds: 300
      transportRetries: 2
    # Ollama, driven by command (`ollama run`). NOT yet verified against the fixture module
    # (see usage.md, "Ollama (local model)") - treat the first run as an experiment.
    #
    # Build the model named below once, from tools/ollama/Modelfile:
    #   ollama create jtestforge-qwen3-coder -f tools/ollama/Modelfile
    # `ollama run` has no flag for num_ctx / temperature / num_predict, and Ollama silently
    # drops the START of a prompt that does not fit num_ctx - the rules, the response
    # contract and the class under test. A derived model is the only way to pin them here,
    # and its num_ctx must hold context.maxPromptChars (60000 chars ~ 17-20k tokens) PLUS
    # the answer: 32768 does, the Ollama default does not.
    # Environment variables in `env` below would NOT help: they reach the `ollama run`
    # client, not the server that actually loads the model.
    # If the model named here does not exist, `ollama run` starts DOWNLOADING it inside the
    # first unit instead of failing - check `ollama list` first.
    ollama:
      command: ollama
      # --keepalive keeps the (large) model loaded between units; --hidethinking keeps a
      # reasoning model's thoughts out of stdout; --verbose prints token counts and timings
      # to stderr, where they end up in <stateDir>/transcripts/<unit>/N.stderr.log -
      # "prompt eval count" close to num_ctx means the prompt was truncated.
      args: ["run", "jtestforge-qwen3-coder", "--nowordwrap", "--hidethinking",
             "--keepalive", "30m", "--verbose"]
      promptDelivery: stdin        # stdin | argument | file
      # The first call also pays the cold load of the model (~17 s for a 12 GB model that
      # is already on disk).
      timeoutSeconds: 900
      transportRetries: 1
      maxPromptChars: 60000
    # Ollama over HTTP (its native /api/chat). NOT yet verified against the fixture module - see
    # usage.md. Unlike `ollama run`, a request can set num_ctx / temperature / repeat_penalty per call -
    # no derived model needed - and a prompt that does not fit num_ctx is refused instead of being
    # silently cut. Uncomment, then set aiProvider.active: ollama-http (or generate -p ollama-http).
    # ollama-http:
    #   type: http
    #   api: ollama                      # the only protocol for now
    #   baseUrl: http://localhost:11434  # a host that is not this machine gets a warning: your code goes there
    #   model: qwen3-coder:30b
    #   options: { num_ctx: 32768, temperature: 0.7, num_predict: 4096 }
    #   keepAlive: 30m
    #   headers: {}                      # never written to a log
    #   timeoutSeconds: 900
    #   maxPromptChars: 60000
  # API keys are NEVER read from this file. They are inherited from the process
  # environment, exactly as the CLI itself expects them.
  #
  # PERFORMANCE, for an agentic CLI (Gemini CLI, Claude Code, GitHub Copilot CLI, ...):
  # its tools are pure latency here, because every piece of context the model needs is
  # already in the prompt. isolateWorkingDirectory above removes anything worth
  # exploring; turning the tools off outright is the CLI's own configuration. The
  # Copilot CLI provider above already does this with its own --available-tools flag
  # (an empty list - "only these tools are available" - denies all of them); for the
  # Gemini CLI, put this in <home>/.gemini/policies/jtestforge.toml:
  #
  #   [[rule]]
  #   toolName = "*"
  #   decision = "deny"
  #   priority = 999
  #   denyMessage = "Tools are disabled: JTestForge supplies all context in the prompt"
  #
  # <home> is the system home directory by default. When that is locked down (a corporate
  # profile you cannot write to), point GEMINI_CLI_HOME at a directory you own via the env
  # block above - the CLI then creates and reads .gemini there instead. That moves ALL
  # user-level config, so copy any existing settings.json/credentials into the new home
  # first, or the CLI will behave as if it had never been configured. Workspace-level
  # policies (<cwd>/.gemini/policies) are NOT a substitute: that tier is currently
  # disabled upstream. The older tools.exclude in settings.json and the --allowed-tools
  # flag still work but are deprecated in favour of these policy files.
  #
  # Installing ripgrep on PATH is worth it too: without it the CLI falls back to a much
  # slower search of whatever directory it can see.

# --- Prompt templates --------------------------------------------------------
# External files so they can be versioned and A/B compared without recompiling.
prompts:
  newTestClass:     prompts/new-test-class.md
  additionalTests:  prompts/additional-tests.md
  killMutants:      prompts/kill-mutants.md
  fixCompilation:   prompts/fix-compilation.md
  fixAssertion:     prompts/fix-assertion.md
  # Sent once per unit when an answer breaks the response format (no ```java block, a
  # whole class, imports in the wrong place...). A project scaffolded before this file
  # existed falls back to the bundled default, with a warning.
  fixContract:      prompts/fix-contract.md
  # Spring tiers (see 7.4). Selected by the tier of the work unit.
  webSliceTests:    prompts/spring-web-slice.md
  dataSliceTests:   prompts/spring-data-slice.md
  jsonSliceTests:   prompts/spring-json-slice.md
  contextTests:     prompts/spring-context.md
  # Shared rules blocks appended to every prompt (style, banned constructs).
  rules:            prompts/rules.md
  springRules:      prompts/spring-rules.md

# --- Spring support ----------------------------------------------------------
spring:
  # auto = enable only if spring-test / spring-boot-starter-test is on the test
  # classpath. JTestForge never adds a dependency to the target pom.
  enabled: auto                 # auto | true | false
  tiers:
    plainUnit: true             # T0 - JUnit 5 + Mockito, no Spring context
    webSlice: true               # T1 - @WebMvcTest + MockMvc
    dataSlice: true              # T2 - @DataJpaTest + embedded database
    jsonSlice: true              # T3 - @JsonTest / @ConfigurationProperties binding
    contextSlice: false          # T4 - minimal @SpringBootTest(classes = ...)
  # Always pick the cheapest tier that can close the gap (7.4).
  preferLowestTier: true
  # Propose a Spring test even at 100% line coverage when framework semantics
  # (mappings, validation, security, transactions, proxies) are unverified (7.5).
  detectFrameworkSemanticGaps: true
  embeddedDatabase: auto        # auto | h2 | hsqldb | derby | none
  allowTestcontainers: false    # needs Docker; slow; opt-in only
  # An ApplicationContext load is the expensive unit of work in a Spring run.
  maxContextLoadsPerRun: 40
  contextLoadTimeoutSeconds: 120
  # Generated tests must never fork or evict the Spring context cache (7.6).
  enforceContextKeyStability: true
  forbidDirtiesContext: true
  # auto = @MockitoBean on Framework 6.2+/Boot 3.4+, @MockBean below.
  mockBeanAnnotation: auto      # auto | mockBean | mockitoBean

# --- Context injection -------------------------------------------------------
context:
  includeFullProductionClass: true
  includeCollaboratorSignatures: true   # signatures of injected dependencies
  maxCollaborators: 12
  includeExistingTestClass: true
  maxExistingTestChars: 20000
  includeDetectedFrameworkVersions: true  # JUnit/Mockito/AssertJ from the pom
  maxPromptChars: 60000

# --- Pass 1: generate --------------------------------------------------------
generate:
  maxTestsPerMethod: 5
  maxRepairAttempts: 2          # compilation/assertion repair rounds per unit
  # Default false: any test that compiles and passes is kept, even with zero coverage
  # gain - and jacoco:report is never invoked, sidestepping a broken JaCoCo setup on the
  # target module. Set true to discard a test that adds no covered line/branch (and
  # bring jacoco:report back, since the gate needs its numbers again).
  requireCoverageGain: false
  requireAssertion: true        # discard a test with no assertion (11.1)
  rejectMockOnlyTests: true     # discard a test whose only checks are verify(...)

# --- Pass 2: harden ----------------------------------------------------------
harden:
  engine: pitestMavenPlugin     # pitestMavenPlugin | standaloneWrapper
  # standaloneWrapperJar: C:/tools/pitest-wrapper.jar   # when engine=standaloneWrapper
  mutators: DEFAULTS            # DEFAULTS | STRONGER | <explicit comma list>
  maxMutantsPerPrompt: 6
  maxAttemptsPerMutant: 2
  minMutationScore: 70          # informational threshold for the report / exit code
  # Highest tier whose tests may be used as PIT's test set. PIT re-runs the suite
  # once per mutant; a slice test is orders of magnitude costlier than a unit test,
  # and controller mapping/validation logic lives in annotations, which PIT does not
  # mutate anyway. Raise deliberately, never by default. T4 is never permitted.
  maxTierForMutation: PLAIN_UNIT   # PLAIN_UNIT | WEB_SLICE | DATA_SLICE | JSON_SLICE
  # Mutants proven unkillable (equivalent mutants, logging, etc). Persistent.
  unkillableMutantsFile: .jtestforge/unkillable.txt
  # PIT history file for incremental analysis. Big speed win across runs.
  historyFile: .jtestforge/pit-history.bin

# --- Execution & safety ------------------------------------------------------
execution:
  # NOT under target/ - 'mvn clean' would wipe the run state.
  stateDir: .jtestforge
  # Keep a copy of every EXISTING test file, as it was before this run first touched it, under
  # <stateDir>/backups/<runId>/ (same layout as the module). A safety net only: units are undone by
  # subtracting what they added, never by restoring a copy. `clean` removes the copies.
  backupOriginalTests: true
  # Do everything up to the AI call and stop: list the units a run would attempt and write each
  # rendered prompt under <stateDir>/dry-run/. No AI call, no test file touched, run state left
  # alone. Same as `generate --dry-run`.
  dryRun: false
  # Abort the run after this many consecutive discarded units (model is unhelpful).
  consecutiveFailureAbort: 5
  maxUnitsPerRun: 0             # 0 = unlimited
